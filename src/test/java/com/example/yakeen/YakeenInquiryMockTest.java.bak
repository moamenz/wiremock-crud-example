package com.example.yakeen;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.github.tomakehurst.wiremock.WireMockServer;
import com.github.tomakehurst.wiremock.core.WireMockConfiguration;
import org.junit.jupiter.api.AfterAll;
import org.junit.jupiter.api.BeforeAll;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import static com.github.tomakehurst.wiremock.client.WireMock.postRequestedFor;
import static com.github.tomakehurst.wiremock.client.WireMock.urlEqualTo;
import static org.junit.jupiter.api.Assertions.*;

import java.net.http.HttpResponse;

class YakeenInquiryMockTest {
    private static WireMockServer server;
    private static final ObjectMapper MAPPER = new ObjectMapper();

    @BeforeAll
    static void start() {
        server = new WireMockServer(WireMockConfiguration.wireMockConfig().port(0));
        server.start();
        YakeenInquiryStubs.registerAll(server);
    }

    @AfterAll
    static void stop() { if (server != null) server.stop(); }

    @BeforeEach
    void reset() { server.resetRequests(); }

    private YakeenInquiryApiClient client() {
        return new YakeenInquiryApiClient(server.baseUrl());
    }

    @Test
    void exactBody_returns200WithSuccessPayload() throws Exception {
        HttpResponse<String> res = client().postInquiry(YakeenInquiryStubs.exactExpectedBody());
        assertEquals(200, res.statusCode());
        JsonNode root = MAPPER.readTree(res.body());
        JsonNode rs = root.path("YakeenPersonInformationInquiryRs");
        assertEquals("I000000", rs.path("MsgRsHdr").path("ResponseStatus").path("StatusCode").asText());
        assertEquals("Success", rs.path("MsgRsHdr").path("ResponseStatus").path("StatusDesc").asText());

        JsonNode item = rs.path("Body").path("Item");
        assertEquals("Omer", item.path("FirstNameEn").asText());
        assertEquals("ALBAHLAL", item.path("FamilyNameEn").asText());
        assertEquals("1446-06-30", item.path("IdExpiryDtHjr").asText());
        JsonNode pf = item.path("PassportList").get(0);
        assertEquals("CX59263", pf.path("PassportNumber").asText());
        assertEquals("2030-05-02T00:00:00", pf.path("PassportExpiryDt").asText());
        com.github.tomakehurst.wiremock.client.WireMock.verify(
                postRequestedFor(urlEqualTo("/YakeenInformationInquiry11")));
    }

    @Test
    void differentPartyId_returns400BodyMismatch() throws Exception {
        String mutated = YakeenInquiryStubs.exactExpectedBody().replace("1000038065", "1000038066");
        HttpResponse<String> res = client().postInquiry(mutated);
        assertEquals(400, res.statusCode());
        JsonNode err = MAPPER.readTree(res.body()).path("ErrorResponse");
        assertEquals("BODY_MISMATCH", err.path("Code").asText());

        com.github.tomakehurst.wiremock.client.WireMock.verify(0,
                postRequestedFor(urlEqualTo("/YakeenInformationInquiry11"))
                        .withRequestBody(com.github.tomakehurst.wiremock.matching.RequestPatternBuilder.equalTo(
                                YakeenInquiryStubs.exactExpectedBody())));
    }
}
